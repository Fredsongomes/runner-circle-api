# ---------------------------------------------------------------
# Docker Compose: copie para .env (cp .env.example .env) e ajuste
# ---------------------------------------------------------------

# Segredo de assinatura do JWT (mínimo 32 bytes). Gere um com: openssl rand -base64 48
# Sem ele, o compose usa um valor padrão que serve SÓ para uso local.
JWT_SECRET=troque-este-segredo-por-um-valor-forte-de-32-bytes-ou-mais

# Porta do Postgres no host (padrão 5432).
# Troque (ex.: 5433) se já tiver um Postgres instalado usando a 5432.
DB_PORT=5432

# Porta da API no host (padrão 8080)
API_PORT=8080

# ---------------------------------------------------------------
# As variáveis abaixo só são usadas ao rodar a API FORA do Docker
# (pelo IntelliJ ou ./mvnw spring-boot:run). O Spring não lê este
# arquivo sozinho: defina-as no terminal ou na Run Configuration.
# ---------------------------------------------------------------
# JWT_SECRET=...                                          (obrigatória)
# DB_PASSWORD=postgres                                    (obrigatória no perfil dev)
# DB_URL=jdbc:postgresql://localhost:5432/runnercircle    (padrão no perfil dev)
# DB_USER=postgres                                        (padrão no perfil dev)
# SERVER_PORT=8080
# UPLOAD_DIR=uploads
# SPRING_PROFILES_ACTIVE=dev                              (dev | prod)
